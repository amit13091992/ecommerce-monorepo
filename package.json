{
  "name": "ecommerce-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace=@ecommerce/api run dev",
    "dev:web": "npm --workspace=@ecommerce/web run dev",
    "build": "npm --workspaces run build",
    "lint": "eslint --ext .ts,.tsx . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "npm --workspace=@ecommerce/api run db:generate",
    "db:migrate": "npm --workspace=@ecommerce/api run db:migrate",
    "db:seed": "npm --workspace=@ecommerce/api run db:seed"
  },
  "devDependencies": {
    "concurrently": "^8.0.1",
    "eslint": "^8.0.0",
    "prettier": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
